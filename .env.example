# Leave DATABASE_URL empty to use the embedded Postgres (PGlite) in ./.data — no install needed.
DATABASE_URL=
# Long random string used to sign session cookies (openssl rand -base64 32)
SESSION_SECRET=
# Optional. Without it the plain-English assistant uses the built-in rule parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
